</head>
<body>
  <a class="skip-link" href="#main" data-i18n="skip">Негізгі мазмұнға өту</a>

  <header class="site-header" id="top">
    <div class="container header-inner">
      <a class="logo" href="#top" aria-label="Нұрсила әже балабақшасы">
        <span class="logo-mark" aria-hidden="true">Н</span>
        <span class="logo-text">
          <strong data-i18n="brand">Нұрсила әже</strong>
          <small data-i18n="brandSub">балабақшасы</small>
        </span>
      </a>
      <nav class="nav" id="nav" aria-label="Main">
        <a href="#about" data-i18n="navAbout">Біз туралы</a>
        <a href="#nursila" data-i18n="navNursila">Нұрсила әже</a>
        <a href="#interior" data-i18n="navInterior">Балабақша</a>
        <a href="#events" data-i18n="navEvents">Іс-шаралар</a>
