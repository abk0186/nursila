          <div class="gallery gallery-dense">
            <img src="assets/events/01.jpg" alt="" /><img src="assets/events/03.jpg" alt="" />
            <img src="assets/events/12.jpg" alt="" /><img src="assets/events/19.jpg" alt="" />
          </div>
        </noscript>
      </div>
