    <section class="section" id="instagram">
      <div class="container narrow">
        <div class="ig-card">
          <div class="ig-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <h2 data-i18n="igTitle">Instagram</h2>
          <p data-i18n="igLead">Күнделікті өмір, Reels және жаңалықтар — біздің парақшада. Reels ендірулері кейін қосылады.</p>
          <a class="btn btn-primary" href="https://www.instagram.com/nursila_aje_balabaqshasy" target="_blank" rel="noopener noreferrer">
            @nursila_aje_balabaqshasy
          </a>
        </div>
      </div>
    </section>

    <section class="section section-contacts" id="contacts">
      <div class="container narrow">
        <h2 data-i18n="contactsTitle">Байланыс</h2>
        <p class="note" data-i18n="contactsNote">Деректер нақтыланады — Asset кейін толықтырады.</p>
        <dl class="contacts-list">
          <div>
            <dt data-i18n="labelPhone">Телефон</dt>
            <dd><span class="placeholder" data-i18n="phPhone">+7 (___) ___-__-__ · нақтыланады</span></dd>
          </div>
          <div>
            <dt data-i18n="labelAddress">Мекенжай</dt>
            <dd><span class="placeholder" data-i18n="phAddress">Қала / аудан · нақтыланады</span></dd>
          </div>
          <div>
            <dt data-i18n="labelEmail">Email</dt>
            <dd><span class="placeholder" data-i18n="phEmail">info@nursila.kz · нақтыланады</span></dd>
          </div>
          <div>
            <dt data-i18n="labelHours">Жұмыс уақыты</dt>
            <dd><span class="placeholder" data-i18n="phHours">нақтыланады</span></dd>
          </div>
          <div>
            <dt>Instagram</dt>
            <dd><a href="https://www.instagram.com/nursila_aje_balabaqshasy" target="_blank" rel="noopener noreferrer">@nursila_aje_balabaqshasy</a></dd>
          </div>
        </dl>
        <p class="domain-note" data-i18n="domainNote">Жоспарланған домен: nursila.kz</p>
      </div>
    </section>
