  <main id="main">
    <section class="hero" id="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-inner">
        <p class="eyebrow" data-i18n="heroEyebrow">Жылулық пен қамқорлық</p>
        <h1 data-i18n="heroTitle">Нұрсила әже балабақшасы</h1>
        <p class="lead" data-i18n="heroLead">Балаларыңызға арналған жылы үй — ойын, тәрбие және қауіпсіз орта.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#contacts" data-i18n="ctaContact">Байланыс</a>
          <a class="btn btn-ghost" href="#nursila" data-i18n="ctaNursila">Нұрсила әже туралы</a>
        </div>
      </div>
    </section>

    <section class="section" id="about">
      <div class="container narrow">
        <h2 data-i18n="aboutTitle">Біз туралы</h2>
        <p data-i18n="aboutP1">«Нұрсила әже» балабақшасы — балалардың күнін жылы, қауіпсіз және қызықты өткізуге арналған орын. Біз ойын арқылы үйретеміз, дәстүрді құрметтейміз және әр балаға жеке көңіл бөлеміз.</p>
        <p data-i18n="aboutP2">Сайттағы фотосуреттер уақытша; кейін жаңа материалдармен жаңартылады. Байланыс деректері нақтыланады.</p>
        <ul class="soft-cards" role="list">
          <li>
            <span class="icon" aria-hidden="true">🏠</span>
            <strong data-i18n="aboutCard1Title">Жылы орта</strong>
            <span data-i18n="aboutCard1Text">Топ бөлмелері, жатын бөлме және ыңғайлы дәліздер</span>
          </li>
          <li>
            <span class="icon" aria-hidden="true">🎉</span>
            <strong data-i18n="aboutCard2Title">Мерекелер</strong>
            <span data-i18n="aboutCard2Text">Ұлттық киім, спорт және мерекелік іс-шаралар</span>
          </li>
          <li>
            <span class="icon" aria-hidden="true">💛</span>
            <strong data-i18n="aboutCard3Title">Қамқорлық</strong>
            <span data-i18n="aboutCard3Text">Ата-аналармен ашық байланыс және құрмет</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section-alt" id="nursila">
      <div class="container">
        <div class="nursila-grid">
          <figure class="nursila-photo">
            <img
              src="assets/nursila/begalieva-nursila-plaque.jpg"
              alt="Бегалиева Нұрсила Оспаналиевна — естелік тақта"
              width="640"
              height="760"
              loading="lazy"
            />
            <figcaption data-i18n="nursilaCaption">Уақытша фото — кейін ауыстырылады</figcaption>
          </figure>
          <div class="nursila-copy">
            <p class="eyebrow" data-i18n="nursilaEyebrow">Есімі берілген</p>
            <h2 data-i18n="nursilaTitle">Нұрсила әже</h2>
            <p class="nursila-name">Бегалиева Нұрсила Оспаналиевна</p>
            <p data-i18n="nursilaLead">Балабақша Қордай ауданының құрметті азаматы Нұрсила Оспаналиевна Бегалиеваның есімімен аталған. Оның еңбегі мен қызметі — біз үшін үлгі.</p>
            <ol class="merits" data-i18n-list="merits">
              <li>Алға ауылдық еңбекшілер депутаттары кеңесінің төрайымы</li>
              <li>Қордай аудандық еңбекшілер депутаттары кеңесінің атқару комитетінің жауапты хатшысы</li>
              <li>Қордай аудандық еңбекшілер депутаттары кеңесінің атқару комитеті төрағасының орынбасары</li>
              <li>Қордай аудандық партия комитетінің Қазақстан компартия хатшысы</li>
              <li>Қордай ауданының құрметті азаматы</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="interior">
      <div class="container">
        <div class="section-head">
          <h2 data-i18n="interiorTitle">Біздің балабақша</h2>
          <p data-i18n="interiorLead">Топ бөлмелері, жатын бөлме және ішкі кеңістік — уақытша фотолар.</p>
        </div>
        <div class="gallery" id="gallery-interior" data-gallery="interior">
          <button type="button" class="gallery-item" data-full="assets/interior/01-group-orange.jpg">
            <img src="assets/interior/01-group-orange.jpg" alt="" loading="lazy" width="640" height="475" data-i18n-alt="int1" />
          </button>
          <button type="button" class="gallery-item" data-full="assets/interior/02-group-yellow.jpg">
            <img src="assets/interior/02-group-yellow.jpg" alt="" loading="lazy" width="640" height="482" data-i18n-alt="int2" />
          </button>
          <button type="button" class="gallery-item" data-full="assets/interior/03-washroom.jpg">
            <img src="assets/interior/03-washroom.jpg" alt="" loading="lazy" width="640" height="471" data-i18n-alt="int3" />
          </button>
          <button type="button" class="gallery-item" data-full="assets/interior/04-group-pink.jpg">
            <img src="assets/interior/04-group-pink.jpg" alt="" loading="lazy" width="640" height="478" data-i18n-alt="int4" />
          </button>
          <button type="button" class="gallery-item" data-full="assets/interior/05-bedroom.jpg">
            <img src="assets/interior/05-bedroom.jpg" alt="" loading="lazy" width="640" height="468" data-i18n-alt="int5" />
          </button>
          <button type="button" class="gallery-item tall" data-full="assets/interior/06-hallway.jpg">
            <img src="assets/interior/06-hallway.jpg" alt="" loading="lazy" width="480" height="640" data-i18n-alt="int6" />
          </button>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="events">
      <div class="container">
        <div class="section-head">
          <h2 data-i18n="eventsTitle">Тәрбие және іс-шаралар</h2>
          <p data-i18n="eventsLead">Сабақтар, мерекелер, спорт және күнделікті өмірден сәттер.</p>
        </div>
        <div class="gallery gallery-dense" id="gallery-events" data-gallery="events">
          <!-- filled by JS from data for maintainability; noscript fallback below -->
        </div>
